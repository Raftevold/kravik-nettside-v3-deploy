<section class="cta-band">
  <div class="ramme cta-band-inner">
    <div>
      <h2><%= design.ctaTitle %></h2>
      <p><%= design.ctaText %></p>
    </div>
    <div class="cta-band-knappar">
      <a class="knapp knapp-lys" href="<%= telHref(site.phone) %>"><%- include('icon', { name: 'telefon' }) %> Ring <%= site.phone %></a>
      <a class="knapp knapp-primar" href="<%= safeUrl(design.ctaUrl) %>"><%= design.ctaButton %></a>
    </div>
  </div>
</section>
