<section class="seksjon" aria-labelledby="avd-tittel"><div class="ramme"><div class="utstilling-hovud"><div><p class="etikett"><%= design.departmentsEyebrow %></p><h2 id="avd-tittel"><%= design.departmentsTitle %></h2></div><p><%= design.departmentsIntro %></p></div><ul class="avdelingar avdelingar-premium"><% for (const d of site.departments) { %><li class="avdeling"><span class="etikett"><%= d.label || 'Avdeling' %></span><h3><%= d.name.split(' – ')[0] %></h3><p><%= d.address %></p><% if(d.note) { %><p class="avdeling-note"><%= d.note %></p><% } %><a class="tekst-lenke" href="<%= telHref(d.phone) %>"><%= d.phone %><span aria-hidden="true">↗</span></a></li><% } %></ul><div class="laerling-linje"><p><%= design.apprenticeText %></p><a class="tekst-lenke" href="<%= safeUrl(design.apprenticeUrl) %>"><%= design.apprenticeLink %> <span aria-hidden="true">↗</span></a></div></div></section>