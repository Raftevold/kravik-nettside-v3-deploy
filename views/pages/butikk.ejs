<%- include('../partials/top') %>
<% const p = content.pages.butikk; %>
<%- include('../partials/sidehovud', { title: p.title, lead: p.intro, image: p.headerImage }) %>

<section class="seksjon">
  <div class="ramme">
    <div class="kort-rutenett kort-rutenett-2">
    <div class="kort kort-stor">
      <span class="logo-brikke"><img src="<%= design.chainLogo ? mediaUrl(design.chainLogo,'md') : '/img/logo-anter.svg' %>" alt="<%= design.chainName %>" width="180" height="35" loading="lazy" /></span>
      <h2><%= p.bathTitle || 'Bad og VVS' %></h2>
      <p><%= p.anterText %></p>
      <p><a class="pil-lenke" href="<%= safeUrl(design.chainUrl) %>" rel="external noopener"><%= design.chainLink %></a></p>
    </div>
    <div class="kort kort-stor">
      <h2><%= p.farmTitle || 'Landbruksavdelinga' %></h2>
      <p><%= p.landbrukText %></p>
      <p><a class="pil-lenke" href="/kontakt">Spør oss om utvalet</a></p>
    </div>
    </div>
  </div>
</section>

<section class="seksjon seksjon-tona">
  <div class="ramme delt">
    <div>
      <h2><%= p.visitTitle || 'Besøk oss i Stryn' %></h2>
      <% if (p.image) { %>
      <img class="butikk-bilete" src="<%= mediaUrl(p.image, 'md') %>" srcset="<%= srcset(p.image) %>" sizes="(min-width: 800px) 50vw, 95vw" alt="<%= mediaAlt(p.image) || 'Butikken vår i Stryn' %>" loading="lazy" />
      <% } %>
      <address class="brodtekst">
        <p><strong><%= site.name %></strong><br /><%= site.address.street %>, <%= site.address.zip %> <%= site.address.city %></p>
      </address>
      <p><a href="<%= telHref(site.phone) %>">Tlf: <%= site.phone %></a> · <a href="mailto:<%= site.email %>"><%= site.email %></a></p>
      <% if (site.openingHours && site.openingHours.length) { %>
      <h3>Opningstider</h3>
      <dl class="opningstider-liste"><% for (const o of site.openingHours) { %><div><dt><%= o.label %></dt><dd><%= o.value %></dd></div><% } %></dl>
      <% } %>
    </div>
    <div class="kart-holdar" data-kart-src="<%= site.mapEmbed %>">
      <div class="kart-plasshaldar">
        <p>Kartet blir levert av Google Maps og blir først lasta når du samtykkjer til eksternt innhald.</p>
        <button type="button" class="knapp knapp-sekundar" data-last-kart>Vis kart</button>
      </div>
    </div>
  </div>
</section>

<section class="seksjon" aria-labelledby="partnar-tittel"><div class="ramme"><p class="etikett">Fagmiljø og samarbeid</p><h2 id="partnar-tittel"><%= p.partnersTitle || 'Samarbeidspartnarane våre' %></h2><div class="partner-grid"><% for(const pa of (content.partners||[]).filter(p=>!p.hidden)){ %><a href="<%= safeUrl(pa.url) %>" rel="external noopener"><% if(pa.image){ %><img src="<%= mediaUrl(pa.image,'md') %>" alt="<%= pa.name %>" loading="lazy" /><% }else if(pa.logo){ %><img src="/img/<%= pa.logo %>.<%= pa.extension||'png' %>" alt="<%= pa.name %>" loading="lazy" /><% }else{ %><h3><%= pa.name %></h3><% } %><p><%= pa.text %></p><span aria-hidden="true">↗</span></a><% } %></div></div></section>
<%- include('../partials/cta-band') %>
<%- include('../partials/bottom') %>
